PORT=4000
HTTPS_PORT=4000
USE_HTTPS=true
SSL_KEY_PATH=server.key
SSL_CERT_PATH=server.crt
JWT_SECRET=knowledge-store-secret

# Where the API listens. The default only accepts connections from this
# machine, which means a video meeting can only ever have one person in it.
# Set 0.0.0.0 to let the rest of the network reach it.
# HOST=0.0.0.0

# Origins the frontend is served from, comma separated, in addition to
# localhost. Needed alongside HOST when other machines load the app.
# ALLOWED_ORIGINS=https://192.168.1.10:6173

# --- Meetings -------------------------------------------------------------
# How many people may be in one call. Every participant sends their camera to
# every other one, so this gets expensive quickly; 4-6 is comfortable.
# MEETING_MAX_PEERS=8

# Largest recording that may be uploaded, in megabytes.
# MEETING_MAX_RECORDING_MB=256

# How browsers find each other. The built-in default is Google's public STUN
# server, which is enough on a LAN and behind most routers. Getting through a
# symmetric NAT or a firewall that blocks peer-to-peer UDP needs a TURN server,
# which relays the media and so has to be one you run or pay for.
# MEETING_STUN_URL=stun:stun.l.google.com:19302
# MEETING_TURN_URL=turn:turn.example.com:3478
# MEETING_TURN_USERNAME=
# MEETING_TURN_PASSWORD=

# Replaces the whole list above with raw RTCIceServer JSON, if you need
# something the individual settings cannot express.
# MEETING_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# --- Face sign-in ----------------------------------------------------------
# How close a captured face must be to an enrolled one. Looser lets strangers
# match; tighter rejects the same person in different light.
# FACE_MATCH_MAX=0.5

# How much closer the best match must be than the second best before the
# server will claim to know which person it is. Signing in by face is a search
# over every account, so this is what stops it guessing between two lookalikes.
# FACE_MATCH_MARGIN=0.05

# --- Voice sign-in (needs the ECAPA model: download_models.py ecapa) --------
# Cosine similarity a voice must reach to sign in, and how far ahead of the
# second-best account it must be. Stricter than Speaker recognition's 0.35,
# because here a wrong answer lets someone in.
# VOICE_LOGIN_THRESHOLD=0.6
# VOICE_LOGIN_MARGIN=0.1
# Voice sign-in attempts per client address per ten minutes.
# VOICE_LOGIN_ATTEMPTS=10

# --- Tools / Transformers: running Python --------------------------------
# Scripts run as this server's OS user — it is not a sandbox. Only accounts
# with the 'transformers:execute' permission (never a default) can run them.
# The interpreter; defaults to "python" on Windows and "python3" elsewhere.
# Point it at a venv's python to pick up transformers/torch installed there.
# PYTHON_BIN=
# A run is killed after this long. The first run of a model downloads it.
# PYTHON_TIMEOUT_MS=300000
# Scripts running at once across all users (each user gets one at a time).
# PYTHON_MAX_CONCURRENT=2

# --- Tools / Transformers: offline models, training and ONNX ---------------
# Where download_models.py put the models (default: backend/python/models).
# TRANSLATION_MODELS_DIR=
# Training and ONNX export jobs running at once across all users. Training
# uses every core (or the GPU); running two only makes both slower.
# TRANSLATION_MAX_JOBS=1
# A training or export job is stopped after this long.
# TRANSLATION_JOB_TIMEOUT_MS=43200000

# --- Tools / YOLO and Speech to Text: training data -----------------------
# Where images and audio uploaded for training are kept (default:
# backend/python/datasets). They can be large: put this on a roomy disk.
# ML_DATASETS_DIR=

# --- Tools / Speech to Text: voice recognition (whisper.cpp) ---------------
# CPU threads whisper.cpp uses per recognition (default: all cores, max 16).
# WHISPER_CPP_THREADS=
# The worker (with its models in memory) stops after this long unused.
# WHISPER_CPP_IDLE_SECONDS=600
# Requests waiting their turn before new ones are turned away (429).
# WHISPER_CPP_MAX_QUEUE=8

# --- Tools / Speaker recognition (ECAPA-TDNN) -----------------------------
# The worker (with the model in memory) stops after this long unused.
# SPEAKER_IDLE_SECONDS=600
# Requests waiting their turn before new ones are turned away (429).
# SPEAKER_MAX_QUEUE=16
# Enrolled voice samples are kept under ML_DATASETS_DIR/speakers/<account id>.

# --- Tools / OCR (PaddleOCR) ------------------------------------------------
# The worker (with the models in memory) stops after this long unused.
# OCR_IDLE_SECONDS=600
# Requests waiting their turn before new ones are turned away (429).
# OCR_MAX_QUEUE=16
# How long one image may take. The first after the worker starts also waits
# for PaddlePaddle to load, which can take minutes on a slow server.
# OCR_REQUEST_SECONDS=300
# PDFs: only the first OCR_MAX_PAGES pages are read, and each page adds
# OCR_PAGE_SECONDS to the time a request may take.
# OCR_MAX_PAGES=30
# OCR_PAGE_SECONDS=60
# oneDNN is off: PaddlePaddle 3.3 fails with it on the PP-OCRv5 models. Set 1
# to try it with another version; it is faster on the CPU where it works.
# OCR_MKLDNN=0

# --- Tools / Converting: audio and video (ffmpeg) -------------------------
# ffmpeg comes from the ffmpeg-static package; set this to use another build
# (one with more encoders, or a system ffmpeg).
# FFMPEG_PATH=
# Largest file accepted for conversion, in MB.
# CONVERT_MAX_UPLOAD_MB=1024
# Conversions running at once across all users; the rest wait in a queue.
# CONVERT_MAX_JOBS=2
# A conversion is stopped after this long.
# CONVERT_TIMEOUT_MINUTES=60
# How long a converted file stays available to preview and download.
# CONVERT_KEEP_MINUTES=60

# --- Camera Management: recording (ffmpeg) ---------------------------------
# Where footage is kept (not under uploads/, which is served without sign-in).
# CAMERA_RECORDINGS_DIR=./recordings
# Length of each recorded file, in minutes (1-60).
# CAMERA_SEGMENT_MINUTES=10
# Footage older than this many days is deleted; 0 keeps it for ever.
# CAMERA_RECORDING_KEEP_DAYS=7
# Cameras recorded at the same time, at most.
# CAMERA_MAX_RECORDERS=8
